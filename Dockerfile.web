# ─── Stage 1: Build Vite App ──────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

RUN corepack enable

# Copy workspace config
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy packages needed by pw-clone
COPY lib/ ./lib/
COPY artifacts/pw-clone/ ./artifacts/pw-clone/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Build the frontend (outputs to artifacts/pw-clone/dist)
RUN pnpm --filter @workspace/pw-clone run build


# ─── Stage 2: Serve with Nginx ────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Copy built static files
COPY --from=builder /app/artifacts/pw-clone/dist /usr/share/nginx/html

# Copy nginx config (SPA routing + compression + caching)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
